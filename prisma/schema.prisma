// Accounting & Financial Management System - Complete Database Schema
// Supports: Chart of Accounts, Vouchers, Ledgers, Bank Reconciliation,
// Project/Segment Accounting, Budgets, Taxation, Aging, Financial Years,
// Integration with Payroll & Fixed Assets
//
// NOTE (Future Iteration): Float fields are currently used for monetary values.
// Prisma maps Float to DOUBLE PRECISION in PostgreSQL, which works for most
// operations but can introduce rounding errors in financial calculations.
// Recommendation: Migrate all monetary Float fields to Decimal(@db.Numeric)
// for exact precision in a future iteration. This is a non-trivial change
// that requires updating all API routes, calculations, and frontend display logic.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// ============================================================
// CORE: Users, Roles, Permissions & Access Control
// ============================================================

// --- Branch Master ---
model Branch {
  id          String   @id @default(cuid())
  code        String   @unique  // e.g., "HO", "ISB", "LHR"
  name        String   // e.g., "Head Office", "Islamabad Branch"
  address     String?
  city        String?
  province    String?  // Punjab, Sindh, KPK, Balochistan, ICT, AJK, GB
  phone       String?
  email       String?
  managerName String?  // Branch manager name
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  departments Department[]
}

// --- Department Master ---
model Department {
  id          String   @id @default(cuid())
  code        String   @unique  // e.g., "FIN", "HR", "IT"
  name        String   // e.g., "Finance", "Human Resources", "Information Technology"
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  headName    String?  // Department head name
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
}

// --- User Master (Enhanced) ---
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  username        String?   @unique  // Login username (optional, defaults to email)
  phone           String?
  passwordHash    String    @default("") // bcrypt hash; empty for system/OAuth users
  role            String    @default("viewer") // Legacy: admin, manager, accountant, auditor, viewer
  isActive        Boolean   @default(true)
  isLocked        Boolean   @default(false) // Account lockout
  lockedUntil     DateTime? // Auto-unlock time
  failedLoginAttempts Int   @default(0)
  avatarUrl       String?   // Optional avatar URL
  lastLoginAt     DateTime?
  lastLoginIp     String?   // IP address of last login
  passwordChangedAt DateTime?
  forcePasswordChange Boolean @default(false) // Must change password on next login
  passwordExpiresAt  DateTime? // Password expiry date

  // Organization
  branchId        String?
  branch          Branch?   @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  employeeId      String?   // Link to Employee record
  designation     String?   // Job title

  // System fields
  createdBy       String?   // User ID who created this user
  updatedBy       String?   // User ID who last updated
  deletedAt       DateTime? // Soft delete timestamp
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  auditLogs       AuditLog[]
  voucherActions  VoucherApproval[]
  userRoles       UserRole[]
  userPermissions UserPermission[]
  sessions        UserSession[]
  loginHistory    LoginHistory[]
  passwordHistory PasswordHistory[]
  approvalActions ApprovalInstanceStep[]

  @@index([branchId])
  @@index([departmentId])
  @@index([isActive])
  @@index([role])
}

// --- Role Master ---
model Role {
  id              String   @id @default(cuid())
  code            String   @unique  // e.g., "SUPER_ADMIN", "FINANCE_MANAGER"
  name            String   // e.g., "Super Admin", "Finance Manager"
  description     String?
  level           Int      @default(0)   // Hierarchy level: 0=highest (Super Admin), 1=Admin, etc.
  parentRoleId    String?  // For role hierarchy / inheritance
  parentRole      Role?    @relation("RoleHierarchy", fields: [parentRoleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  childRoles      Role[]   @relation("RoleHierarchy")
  isSystem        Boolean  @default(false) // System roles cannot be deleted
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@index([level])
  @@index([isActive])
}

// --- Permission Master ---
model Permission {
  id              String   @id @default(cuid())
  code            String   @unique  // e.g., "VOUCHER_CREATE", "VOUCHER_APPROVE"
  name            String   // e.g., "Create Voucher", "Approve Voucher"
  description     String?
  module          String   // e.g., "vouchers", "accounts", "payroll", "users"
  action          String   // view, create, edit, delete, approve, reject, export, print, reverse, post, unpost
  resource        String   // e.g., "voucher", "account", "employee", "user"
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@unique([module, action, resource])
  @@index([module])
  @@index([action])
  @@index([resource])
}

// --- Role-Permission Mapping ---
model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  isGranted    Boolean    @default(true) // true=grant, false=deny (deny overrides grant)
  conditions   String?    // JSON: branch-specific, amount-limit, etc.
  createdBy    String?
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

// --- User-Role Mapping (supports multiple roles per user) ---
model UserRole {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  isPrimary Boolean  @default(false) // Primary role determines default permissions
  grantedBy String?  // User ID who granted this role
  grantedAt DateTime @default(now())
  expiresAt DateTime? // Role can be temporary

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

// --- User-Permission Override (user-level overrides) ---
model UserPermission {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  isGranted    Boolean    // true=grant override, false=deny override
  conditions   String?    // JSON: specific conditions
  grantedBy    String?
  createdAt    DateTime   @default(now())
  expiresAt    DateTime?

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
}

// --- User Session Tracking ---
model UserSession {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  token           String    @unique  // Session token
  refreshToken    String?   @unique  // Refresh token
  deviceInfo      String?   // JSON: {browser, os, device}
  deviceFingerprint String? // Device fingerprint hash
  ipAddress       String?
  geoLocation     String?   // JSON: {country, city, lat, lon}
  isActive        Boolean   @default(true)
  expiresAt       DateTime
  lastActivityAt  DateTime  @default(now())
  createdAt       DateTime  @default(now())

  @@index([userId])
  @@index([token])
  @@index([isActive])
  @@index([expiresAt])
}

// --- Login History ---
model LoginHistory {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  email           String   // Email used for login attempt
  loginStatus     String   // success, failed, locked, expired_token
  failureReason   String?  // invalid_password, account_locked, account_inactive, etc.
  ipAddress       String?
  userAgent       String?  // Raw User-Agent header
  browser         String?  // Parsed browser name + version
  os              String?  // Parsed OS
  device          String?  // desktop, mobile, tablet
  geoLocation     String?  // JSON: {country, city}
  sessionId       String?  // Link to UserSession on success
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([loginStatus])
  @@index([createdAt])
  @@index([email])
}

// --- Password History ---
model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  passwordHash String   // Previous password hash
  changedAt    DateTime @default(now())
  changedBy    String?  // User ID who changed it (admin reset vs self-change)
  changeType   String   @default("self") // self, admin_reset, system
  ipAddress    String?

  @@index([userId])
  @@index([changedAt])
}

// --- Security Policy Configuration ---
model SecurityPolicy {
  id                        String   @id @default(cuid())
  name                      String   @unique  // e.g., "Default Security Policy"
  description               String?

  // Password Policy
  passwordMinLength          Int      @default(8)
  passwordMaxLength          Int      @default(128)
  passwordRequireUppercase   Boolean  @default(true)
  passwordRequireLowercase   Boolean  @default(true)
  passwordRequireNumbers     Boolean  @default(true)
  passwordRequireSpecial     Boolean  @default(true)
  passwordExpiryDays         Int      @default(90)  // 0 = never expires
  passwordHistoryCount       Int      @default(5)   // Can't reuse last N passwords
  passwordMinAgeDays         Int      @default(1)   // Can't change again within N days

  // Account Lockout
  lockoutThreshold          Int      @default(5)   // Failed attempts before lockout
  lockoutDurationMinutes    Int      @default(30)  // Lockout duration
  lockoutIncrementDuration  Boolean  @default(true) // Increase duration on repeated lockouts

  // Session Policy
  sessionTimeoutMinutes     Int      @default(480)  // 8 hours
  idleTimeoutMinutes        Int      @default(30)   // 30 min idle
  maxConcurrentSessions     Int      @default(3)    // Max simultaneous sessions per user
  singleSessionEnforcement  Boolean  @default(false) // Kill other sessions on new login

  // Login Policy
  allowRememberMe           Boolean  @default(true)
  rememberMeDays            Int      @default(30)
  requireMfa                Boolean  @default(false) // Require 2FA/MFA
  mfaMethod                 String   @default("totp") // totp, sms, email

  // IP & Access
  ipWhitelist               String?  // JSON array of allowed IPs/ranges
  ipBlacklist               String?  // JSON array of blocked IPs/ranges
  geoRestrictions           String?  // JSON: {allowedCountries: ["PK"]}
  allowedLoginHours         String?  // JSON: {start: "08:00", end: "22:00"}

  // General
  isDefault                 Boolean  @default(false)
  isActive                  Boolean  @default(true)
  updatedBy                 String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

// --- Approval Workflow Definition ---
model ApprovalWorkflow {
  id              String   @id @default(cuid())
  name            String   // e.g., "Journal Entry Approval", "Expense Approval"
  code            String   @unique // e.g., "JE_APPROVAL", "EXPENSE_APPROVAL"
  description     String?
  module          String   // vouchers, expenses, payroll, etc.
  entityType      String   // Voucher, Expense, PayrollBatch, etc.
  isActive        Boolean  @default(true)
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  steps           WorkflowStep[]
  instances       ApprovalInstance[]
}

// --- Workflow Step Definition ---
model WorkflowStep {
  id              String   @id @default(cuid())
  workflowId      String
  workflow        ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  stepNumber      Int      // 1, 2, 3...
  stepName        String   // e.g., "Manager Review", "Finance Approval"
  stepType        String   @default("role") // role, user, condition, auto
  approverRoleId  String?  // If stepType=role
  approverUserId  String?  // If stepType=user (specific person)
  condition       String?  // JSON: {field: "amount", operator: ">", value: 50000}
  isParallel      Boolean  @default(false) // Can this step run in parallel with next?
  escalationMinutes Int?   // Auto-escalate after N minutes
  escalationTo    String?  // Role or user ID to escalate to
  isRequired      Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([workflowId])
}

// --- Approval Instance (runtime) ---
model ApprovalInstance {
  id              String   @id @default(cuid())
  workflowId      String
  workflow        ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  entityId        String   // ID of the entity being approved
  entityType      String   // Voucher, Expense, etc.
  entityNumber    String?  // Human-readable reference (e.g., voucher number)
  currentStep     Int      @default(1)
  totalSteps      Int
  status          String   @default("pending") // pending, approved, rejected, cancelled, escalated
  requestedBy     String?  // User ID who submitted
  requestedAt     DateTime @default(now())
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  steps           ApprovalInstanceStep[]
  auditLogs       AuditLog[]

  @@index([workflowId])
  @@index([entityId])
  @@index([status])
  @@index([requestedBy])
}

// --- Approval Instance Step (runtime) ---
model ApprovalInstanceStep {
  id              String   @id @default(cuid())
  instanceId      String
  instance        ApprovalInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  stepNumber      Int
  stepName        String
  approverUserId  String?
  approver        User?    @relation(fields: [approverUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approverRoleId  String?
  status          String   @default("pending") // pending, approved, rejected, skipped, escalated
  comments        String?
  actionDate      DateTime?
  delegatedTo     String?  // User ID if delegated
  delegatedBy     String?  // User ID who delegated
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([instanceId])
  @@index([approverUserId])
  @@index([status])
}

// --- Enhanced Audit Log ---
model AuditLog {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  username        String?  // Denormalized for quick display
  action          String   // LOGIN, LOGOUT, CREATE, UPDATE, DELETE, APPROVE, REJECT, EXPORT, PRINT, REVERSE, POST, PERMISSION_CHANGE, PASSWORD_CHANGE
  entity          String   // Account, Voucher, User, Role, Permission, etc.
  entityId        String?
  entityName      String?  // Human-readable name of the entity
  details         String?  // JSON string with change details
  oldValues       String?  // JSON: previous state
  newValues       String?  // JSON: new state
  ipAddress       String?
  userAgent       String?
  sessionId       String?  // Link to session
  approvalInstanceId String? // Link to approval workflow
  approvalInstance ApprovalInstance? @relation(fields: [approvalInstanceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  severity        String   @default("info") // info, warning, critical
  module          String?  // Module where action occurred
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
  @@index([severity])
  @@index([module])
}

// ============================================================
// CHART OF ACCOUNTS
// ============================================================

model Account {
  id            String    @id @default(cuid())
  code          String    @unique
  name          String
  accountType   String    // ASSET, LIABILITY, EQUITY, INCOME, EXPENSE
  subType       String?   // CURRENT_ASSET, FIXED_ASSET, CURRENT_LIABILITY, etc.
  parentId      String?   // For hierarchical accounts
  parent        Account?  @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children      Account[] @relation("AccountHierarchy")
  level         Int       @default(0)
  isActive      Boolean   @default(true)
  isSystem      Boolean   @default(false) // System accounts cannot be deleted
  allowPosting  Boolean   @default(true) // Whether direct postings allowed
  openingBalance Float    @default(0)
  description   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  voucherEntries    VoucherEntry[]
  budgetEntries   BudgetLine[]
  taxAccounts     TaxRate[]
  bankStatements  BankStatement[]
  bankReconciliations BankReconciliation[]

  // Employee accounting config reverse relations
  empSalaryExpense  Employee[] @relation("EmpSalaryExpense")
  empScExpense      Employee[] @relation("EmpScExpense")
  empSalaryPayable  Employee[] @relation("EmpSalaryPayable")
  empScPayable      Employee[] @relation("EmpScPayable")
  empTaxPayable     Employee[] @relation("EmpTaxPayable")
}

// ============================================================
// FINANCIAL YEAR
// ============================================================

model FinancialYear {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "FY 2024-25"
  startDate   DateTime
  endDate     DateTime
  status      String   @default("open") // open, closing, closed
  closedBy    String?
  closedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vouchers    Voucher[]
  budgets     Budget[]
}

// ============================================================
// PROJECTS & SEGMENTS
// ============================================================

model Project {
  id                   String    @id @default(cuid())
  code                 String    @unique // e.g. "AJK-HPP", "HO"
  name                 String
  projectType          String    @default("Other") // Head Office, Hydropower, Dam, Infrastructure, Other
  description          String?
  startDate            DateTime?
  endDate              DateTime?
  status               String    @default("active") // active, completed, on-hold
  isHeadOffice         Boolean   @default(false)
  reportingCurrency    String    @default("PKR")
  sortOrder            Int       @default(0) // column ordering in multi-column reports
  parentProjectId      String?   // self-referencing for sub-projects
  parentProject        Project?  @relation("ProjectHierarchy", fields: [parentProjectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subProjects          Project[] @relation("ProjectHierarchy")
  intraCompanyAccountId String?  // FK to Account for intra-company eliminations
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  vouchers    Voucher[]
  budgets     Budget[]
  employeeAssignments EmployeeProjectAssignment[]
  defaultEmployees    Employee[] // Employees with this as default project
  dailyProjectRecords AttendanceDailyProject[]
  costLedgerEntries  ProjectCostLedger[]
}

model FinancialReportConfig {
  id              String   @id @default(cuid())
  reportName      String
  reportType      String   // Balance Sheet, P&L, Cash Flow, Fixed Asset Schedule, Intangible Asset Schedule, Multi-Column Balance Sheet
  viewMode        String   @default("single") // single, multi_column, consolidated
  fromDate        DateTime
  toDate          DateTime
  projectIds      String   @default("[]") // JSON array of project IDs
  detailLevel     String   @default("summary") // summary, detailed
  isFinalized     Boolean  @default(false)
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Donor {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  contactPerson String?
  email       String?
  phone       String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vouchers    Voucher[]
  budgets     Budget[]
}

model Location {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vouchers    Voucher[]
}

model Client {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  industry      String?  // e.g., Government, NGO, Corporate, Individual
  taxNumber     String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vouchers    Voucher[]
}

// ============================================================
// CUSTOMERS & SUPPLIERS (Sub-Ledger Masters)
// ============================================================

model Customer {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  creditTerms   Int      @default(30) // days
  creditLimit   Float    @default(0)
  taxNumber     String?
  isActive      Boolean  @default(true)
  openingBalance Float   @default(0) // Receivable opening balance
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  voucherEntries VoucherEntry[]
}

model Supplier {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  creditTerms   Int      @default(30) // days
  taxNumber     String?
  bankName      String?
  bankAccount   String?
  isActive      Boolean  @default(true)
  openingBalance Float   @default(0) // Payable opening balance
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  voucherEntries VoucherEntry[]
}

// ============================================================
// VOUCHER MANAGEMENT
// ============================================================

model Voucher {
  id              String    @id @default(cuid())
  voucherNumber   String    @unique
  voucherType     String    // BP, CP, BR, CR, JV, BILL
  voucherTypeName String    // Bank Payment, Cash Payment, Bank Receipt, Cash Receipt, Journal Voucher, Bill
  date            DateTime
  narration       String
  reference       String?
  payeeName       String?   // Name of the payee/beneficiary
  chequeNumber    String?
  chequeDate      DateTime?
  voucherNo       String?   // Manual/custom voucher number (separate from auto-generated voucherNumber)
  amountInWords   String?   // Total amount expressed in words
  status          String    @default("draft") // draft, pending, approved, posted, rejected
  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  projectId       String?
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  donorId         String?
  donor           Donor?    @relation(fields: [donorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  locationId      String?
  location        Location? @relation(fields: [locationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  clientId        String?
  client          Client?   @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  totalDebit      Float     @default(0)
  totalCredit     Float     @default(0)
  isPayrollPosted Boolean   @default(false) // INTEGRATION: Payroll → GL
  isAssetPosted   Boolean   @default(false) // INTEGRATION: Fixed Assets → GL
  isReconciled    Boolean   @default(false) // BANK RECONCILIATION: Whether this voucher has been cleared in bank reconciliation
  clearanceDate   DateTime? // BANK RECONCILIATION: Date when the voucher was cleared on bank statement
  createdBy       String
  reviewedBy      String?   // Manager who moved to Pending
  approvedBy      String?   // Manager/Admin who approved
  postedBy        String?   // Admin who posted to GL
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  entries       VoucherEntry[]
  approvals     VoucherApproval[]
  attachments   VoucherAttachment[]
  bankRecon     BankReconciliationItem[]
}

model VoucherEntry {
  id          String  @id @default(cuid())
  voucherId   String
  voucher     Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  lineNumber  Int
  accountId   String
  account     Account @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  debit       Float   @default(0)
  credit      Float   @default(0)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  description String?
  projectId   String? // Override at line level
  donorId     String? // Override at line level
  locationId  String? // Override at line level

  // INTEGRATION: Payroll reference
  payrollRef  String? // Reference to payroll batch
  // INTEGRATION: Fixed Asset reference
  assetRef    String? // Reference to fixed asset
}

model VoucherApproval {
  id          String   @id @default(cuid())
  voucherId   String
  voucher     Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  action      String   // SUBMIT, REVIEW, APPROVE, REJECT, POST, QUICK_POST, REVOKE
  fromStatus  String?  // Previous status before action
  toStatus    String?  // New status after action
  comments    String?
  userRole    String?  // Role of the user at time of action
  createdAt   DateTime @default(now())
}

model VoucherAttachment {
  id          String   @id @default(cuid())
  voucherId   String
  voucher     Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  fileName    String
  filePath    String   // Secure storage path (not publicly accessible)
  fileSize    Int?
  fileType    String?  // MIME type
  mimeType    String?  // application/pdf, image/jpeg, etc.
  category    String?  // invoice, receipt, contract, other
  description String?
  uploadedBy  String
  uploadedByName String? // Denormalized for display
  isVerified  Boolean  @default(false) // Verified by manager/admin
  createdAt   DateTime @default(now())
}

// ============================================================
// BANK RECONCILIATION
// ============================================================

model BankStatement {
  id            String   @id @default(cuid())
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  statementDate DateTime
  openingBalance Float
  closingBalance Float
  importedAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  items         BankStatementItem[]
}

model BankStatementItem {
  id            String   @id @default(cuid())
  bankStatementId String
  bankStatement  BankStatement @relation(fields: [bankStatementId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  date          DateTime
  description   String
  amount        Float
  type          String   // DEPOSIT, WITHDRAWAL
  reference     String?
  isMatched     Boolean  @default(false)

  reconItems    BankReconciliationItem[]
}

model BankReconciliationItem {
  id                  String   @id @default(cuid())
  bankStatementItemId String? @unique
  bankStatementItem   BankStatementItem? @relation(fields: [bankStatementItemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  voucherId           String
  voucher             Voucher  @relation(fields: [voucherId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reconciliationDate  DateTime @default(now())
  status              String   @default("matched") // matched, unmatched, outstanding
  reconciledBy        String
  createdAt           DateTime @default(now())
}

model BankReconciliation {
  id                String   @id @default(cuid())
  accountId         String
  account           Account  @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  period            String   // "2025-01" format (YYYY-MM)
  statementBalance  Float    // User-entered bank statement balance (CR)
  bookBalance       Float    // Computed book balance (DR)
  unpresentedTotal  Float    @default(0) // Sum of unchecked payments
  uncreditedTotal   Float    @default(0) // Sum of unchecked receipts
  adjustedBookBalance  Float @default(0)
  adjustedBankBalance  Float @default(0)
  status            String   @default("draft") // draft, finalized
  finalizedBy       String?
  finalizedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([accountId, period])
}

// ============================================================
// BUDGET MANAGEMENT
// ============================================================

model Budget {
  id              String   @id @default(cuid())
  name            String
  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  donorId         String?
  donor           Donor?   @relation(fields: [donorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  period          String?  // MONTHLY, QUARTERLY, ANNUAL
  status          String   @default("draft") // draft, approved, active
  totalAmount     Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lines           BudgetLine[]
}

model BudgetLine {
  id          String   @id @default(cuid())
  budgetId    String
  budget      Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  period      String   // "2024-01", "2024-Q1", "2024"
  budgetAmount Float
  actualAmount Float    @default(0)
  commitmentAmount Float @default(0)
}

// ============================================================
// TAXATION
// ============================================================

model TaxRate {
  id          String   @id @default(cuid())
  name        String
  taxType     String   // INCOME_TAX, SALES_TAX, GST, ZAKAT
  rate        Float
  accountId   String?  // Default tax account
  account     Account? @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  calculations TaxCalculation[]
}

model TaxCalculation {
  id            String   @id @default(cuid())
  taxRateId     String
  taxRate       TaxRate  @relation(fields: [taxRateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  voucherId     String?
  baseAmount    Float
  taxAmount     Float
  period        String   // "2024-01"
  calculatedAt  DateTime @default(now())
  postedToGL    Boolean  @default(false)
}

// ============================================================
// FINANCIAL YEAR BALANCES (for carry-forward)
// ============================================================

model AccountBalance {
  id              String   @id @default(cuid())
  accountId       String
  // Note: AccountBalance references Account but no formal FK to avoid circular issues
  financialYearId String
  openingDebit    Float    @default(0)
  openingCredit   Float    @default(0)
  periodDebit     Float    @default(0)
  periodCredit    Float    @default(0)
  closingDebit    Float    @default(0)
  closingCredit   Float    @default(0)
  period          String   // "2024-01", "2024-Q1", "2024"

  @@unique([accountId, financialYearId, period])
}

// ============================================================
// FIXED ASSETS MANAGEMENT SYSTEM (FAMS)
// ============================================================

model FixedAsset {
  id                    String   @id @default(cuid())
  assetId               String   @unique  // AST-YYYY-NNNN
  name                  String
  description           String?
  category              String   // Land, Buildings, Vehicles, Furniture, Office Equipment, IT Assets, Machinery, Other
  subCategory           String?
  dateOfPurchase        DateTime
  dateOfCapitalization  DateTime
  purchasePrice         Float    // PKR
  residualValue         Float    @default(0) // PKR
  usefulLifeYears       Int      @default(0)
  depreciationMethod    String   @default("Straight-Line") // Straight-Line, Declining-Balance, None
  decliningRate         Float    @default(0) // % for declining balance
  custodian             String?
  location              String?
  province              String   @default("KPK") // Punjab, Sindh, KPK, Balochistan, ICT, AJK, GB
  donor                 String?
  isDonorFunded         Boolean  @default(false)
  donorRestrictions     String?
  grantReference        String?
  invoiceNumber         String?
  supplierName          String?
  supplierNTN           String?
  warrantyExpiryDate    DateTime?
  serialNumber          String?
  make                  String?   // e.g., Toyota, Dell, HP
  model                 String?   // e.g., Corolla, Latitude 5520
  modelYear             Int?      // e.g., 2023
  priorApprovalNo       String?   // Prior approval reference number
  purchaseOrderNo       String?   // Purchase order number
  receiptVoucherNo      String?   // Receipt voucher reference
  checkRegisterNo       String?   // Check register reference
  stockRegisterPageNo   String?   // Stock register page number
  assetTag              String?   // Manual asset tag identifier (e.g., FA-IT-2024-001)
  status                String   @default("Active") // Active, Disposed, Transferred, Under Maintenance, Written Off
  condition             String   @default("Good") // Excellent, Good, Fair, Poor
  insuranceValue        Float    @default(0)
  insurancePolicyNumber String?
  insuranceExpiryDate   DateTime?
  costCenter            String?
  project               String?
  fundCode              String?
  donorCode             String?
  glAssetAccount        String?
  glAccDepAccount       String?
  glDepExpAccount       String?
  taxCategory           String?
  taxRate               Float    @default(0)
  taxMethod             String   @default("Declining-Balance")
  approvalStatus        String   @default("Draft") // Draft, Pending Approval, Approved, Rejected
  approvedBy            String?
  createdBy             String?
  journalStatus         String   @default("Pending Export") // Pending Export, Exported
  notes                 String?
  accumulatedDepreciation Float  @default(0)
  netBookValue          Float    @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  depreciationRecords   FixedAssetDepreciation[]
  transactions          AssetTransaction[]
}

model FixedAssetDepreciation {
  id                      String   @id @default(cuid())
  assetId                 String
  asset                   FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  financialYear           String   // "2024-25"
  period                  String   // "Jul-2024"
  monthNumber             Int      // 1-12 (1=July)
  openingNBV              Float
  depreciationCharge      Float
  accumulatedDepreciation Float
  closingNBV              Float
  isPosted                Boolean  @default(false)
  journalRef              String?
  journalStatus           String   @default("Pending Export") // Pending Export, Exported
  isTaxDepreciation       Boolean  @default(false) // true for FBR tax depreciation
  taxOpeningWDV           Float    @default(0)
  taxCharge               Float    @default(0)
  taxClosingWDV           Float    @default(0)
  createdAt               DateTime @default(now())
}

model AssetTransaction {
  id              String   @id @default(cuid())
  txnId           String   @unique  // TXN-YYYY-NNNN
  assetId         String
  asset           FixedAsset @relation(fields: [assetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  type            String   // Addition, Disposal, Transfer, Adjustment, Reversal
  date            DateTime
  description     String?
  amount          Float    @default(0)
  fromLocation    String?
  toLocation      String?
  fromCustodian   String?
  toCustodian     String?
  fromCostCenter  String?
  toCostCenter    String?
  proceeds        Float    @default(0) // For disposal
  gainLoss        Float    @default(0) // Positive = gain, negative = loss
  disposalMethod  String?  // Sale, Scrap, Donation, Write-Off, Transfer to Govt
  adjustmentType  String?  // Upward Revaluation, Downward (Impairment), Correction
  newValue        Float?   // For adjustments/revaluations
  transferCertNo  String?  // TC-YYYY-NNNN
  approvedBy      String?
  status          String   @default("Draft") // Draft, Approved, Posted, Reversed, Pending Acknowledgment
  journalRef      String?
  journalStatus   String   @default("Pending Export") // Pending Export, Exported, N/A
  notes           String?
  createdBy       String?
  createdAt       DateTime @default(now())
}

model FAMSFiscalYear {
  id            String   @id @default(cuid())
  label         String   @unique // "2024-25"
  startDate     DateTime
  endDate       DateTime
  status        String   @default("Open") // Open, Closed
  depRunStatus  String   @default("{}") // JSON: {"Jul-2024": "Complete", "Aug-2024": "Pending", ...}
  openedBy      String?
  openedAt      DateTime @default(now())
  closedBy      String?
  closedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model FAMSJournal {
  id              String   @id @default(cuid())
  journalNumber   String   @unique  // JV-FAMS-YYYY-NNNN
  type            String   // Addition, Depreciation, Disposal, Adjustment
  date            DateTime
  narration       String?
  assetId         String?
  assetName       String?
  drAccountCode   String?
  drAccountName   String?
  drAmount        Float    @default(0)
  crAccountCode   String?
  crAccountName   String?
  crAmount        Float    @default(0)
  costCenter      String?
  project         String?
  fundCode        String?
  source          String   @default("FAMS")
  status          String   @default("Pending Export") // Pending Export, Exported, Reversed
  exportBatchId   String?
  createdAt       DateTime @default(now())
  exportedAt      DateTime?
}

model FAMSExportBatch {
  id              String   @id @default(cuid())
  batchRef        String   @unique  // EXP-YYYY-NNNN
  exportDate      DateTime @default(now())
  exportedBy      String?
  entryCount      Int      @default(0)
  totalDrAmount   Float    @default(0)
  totalCrAmount   Float    @default(0)
  csvContent      String?  // Store the CSV content for re-download
  createdAt       DateTime @default(now())
}

model FAMSSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String   @default("fams") // fams, gl-mapping, thresholds, tax-rates
  description String?
  updatedAt DateTime @updatedAt
}

// ============================================================
// PAYROLL & HR MANAGEMENT SYSTEM
// ============================================================

// --- Employee Master (Highly Normalized) ---
model Employee {
  id                String   @id @default(cuid())
  employeeCode      String   @unique // Auto-generated: EMP-0001

  // Personal Info
  name              String
  fatherName        String?
  cnic              String   @unique // Must be unique
  ntn               String?
  dateOfBirth       DateTime?
  religion          String?
  gender            String?  // Male, Female, Other
  contactNo         String?
  email             String?
  permanentAddress  String?
  presentAddress    String?
  profilePhotoUrl   String?  // File path for profile photo

  // Employment Info
  designation       String?
  department        String?
  joiningDate       DateTime?
  leavingDate       DateTime? // Null if active
  employmentType    String?   // Permanent, Contract, Temporary, Intern, Consultant
  category          String?   // Management, Staff, Worker, Officer
  defaultProjectId  String?   // Default project assignment
  defaultProject    Project? @relation(fields: [defaultProjectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  status            String   @default("active") // active, inactive, terminated, resigned, retired

  // Banking
  bankName          String?
  branchName        String?
  branchCode        String?
  bankAccountNumber String?

  // Statutory
  eobiNumber        String?
  socialSecurityNo  String?
  eobiEnabled       Boolean  @default(false) // Whether EOBI deduction applies
  pfEnabled         Boolean  @default(false) // Whether Provident Fund deduction applies
  incomeTaxEnabled  Boolean  @default(true)  // Whether Income Tax deduction applies
  essiEnabled       Boolean  @default(false) // Whether ESSI (Employees Social Security Institution) deduction applies
  gratuityEnabled   Boolean  @default(false) // Whether Gratuity provision applies

  // Allocation Settings
  applyToAllProjects Boolean  @default(false) // Whether employee works on all assigned projects
  defaultAllocationMethod String @default("days") // days, percentage — default method for project cost allocation

  // Tax Profile
  taxFilingStatus   String?  // filer, non-filer — FBR Pakistan tax status
  taxCity           String?  // City for FBR PSID report

  // Qualification
  qualification1    String?
  institute1        String?
  year1             String?
  qualification2    String?
  institute2        String?
  year2             String?

  // Experience
  previousEmployer  String?
  yearsOfExperience String?

  // Next of Kin
  nokName           String?
  nokCnic           String?
  nokContact        String?
  nokRelation       String?

  // Salary
  baseSalary        Float    @default(0) // Current base salary
  paymentType       String   @default("monthly") // monthly, daily, hourly

  // Accounting Configuration (for voucher generation)
  salaryExpenseAccountId  String?  // FK to Account — e.g., 05-01-01-XXXX · Project Salary Cost
  salaryExpenseAccount    Account? @relation("EmpSalaryExpense", fields: [salaryExpenseAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  scExpenseAccountId      String?  // FK to Account — e.g., 05-02-XX-XXXX · Employer SC Cost
  scExpenseAccount        Account? @relation("EmpScExpense", fields: [scExpenseAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  salaryPayableAccountId  String?  // FK to Account — e.g., 03-02-02-XXXX · Employee Salary Payable
  salaryPayableAccount    Account? @relation("EmpSalaryPayable", fields: [salaryPayableAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  scPayableAccountId      String?  // FK to Account — e.g., 03-02-03-XXXX · SC Payable to Authority
  scPayableAccount        Account? @relation("EmpScPayable", fields: [scPayableAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  taxPayableAccountId     String?  // FK to Account — e.g., 03-02-07-XXXX · Income Tax (WHT) Payable
  taxPayableAccount       Account? @relation("EmpTaxPayable", fields: [taxPayableAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // System
  isFinancialUsed   Boolean  @default(false) // Cannot delete after financial usage
  createdBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  salaryHistory     EmployeeSalaryHistory[]
  projectAssignments EmployeeProjectAssignment[]
  allowances        EmployeeAllowance[]
  attendanceRecords Attendance[]
  dailyProjectRecords AttendanceDailyProject[]
  costLedgerEntries ProjectCostLedger[]
  loanRecords       Loan[]
  payrollLines      PayrollBatchLine[]
  finalSettlement   FinalSettlement?
  documents         EmployeeDocument[]
}

// ============================================================
// Document Management
// ============================================================

model DocumentType {
  id              String   @id @default(cuid())
  name            String   @unique            // e.g. "CNIC (Front)", "Employment Contract"
  code            String   @unique            // e.g. "CNIC_FRONT", "EMPLOYMENT_CONTRACT"
  isRequired      Boolean  @default(false)    // Mandatory document
  hasExpiry       Boolean  @default(false)    // Document has expiry date
  allowedFormats  String   @default("pdf,jpg,jpeg,png,docx") // Comma-separated
  maxFileSizeKB   Int      @default(5120)     // 5MB default
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  documents       EmployeeDocument[]
}

model EmployeeDocument {
  id              String      @id @default(cuid())
  employeeId      String
  documentTypeId  String
  documentType    DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  employee        Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  title           String                         // Display title
  documentNumber  String?                         // CNIC: 35202-1234567-1, Contract #: C-2024-001
  issueDate       DateTime?                       // When document was issued
  expiryDate      DateTime?                       // When document expires (if hasExpiry)
  notes           String?                         // Remarks

  // File storage
  fileName        String                          // Original file name
  filePath        String                          // Server-side storage path
  fileSize        Int                             // File size in bytes
  fileType        String                          // MIME type
  fileHash        String?                         // SHA-256 hash for integrity

  // Version control
  version         Int          @default(1)        // Current version number
  previousVersionId String?                        // ID of previous version (archived)
  isArchived      Boolean      @default(false)     // Soft archive flag

  // Metadata
  uploadedBy      String       @default("system")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  auditLogs       DocumentAuditLog[]

  @@index([employeeId])
  @@index([documentTypeId])
  @@index([expiryDate])
}

model DocumentAuditLog {
  id              String   @id @default(cuid())
  documentId      String
  document        EmployeeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  action          String   // UPLOADED, VIEWED, DOWNLOADED, REPLACED, DELETED
  performedBy     String   @default("system")
  details         String?  // JSON: {fileName, fileSize, reason, oldVersion, newVersion}
  ipAddress       String?
  createdAt       DateTime @default(now())

  @@index([documentId])
  @@index([action])
  @@index([createdAt])
}

model EmployeeSalaryHistory {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  effectiveDate   DateTime // When the salary change took effect
  previousSalary  Float    @default(0)
  newSalary       Float
  changeReason    String?  // Annual increment, Promotion, Adjustment, Lateral move
  approvedBy      String?
  createdBy       String?
  createdAt       DateTime @default(now())
}

// --- Employee-Project Assignment Engine ---
model EmployeeProjectAssignment {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role            String?  // Role/Designation on this project
  salaryAmount    Float    @default(0) // Project-specific salary
  allocationType  String   @default("fixed") // fixed, percentage, attendance_based
  allocationValue Float    @default(100) // Percentage or fixed amount
  startDate       DateTime
  endDate         DateTime? // Null = ongoing
  isActive        Boolean  @default(true)
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// --- Allowances & Benefits Engine ---
model Allowance {
  id              String   @id @default(cuid())
  code            String   @unique // MED, HRA, TA, PA
  name            String   // Medical Allowance, Housing, Transport, Project Allowance
  allowanceType   String   @default("fixed") // fixed, percentage
  value           Float    @default(0) // Fixed amount or percentage
  baseOnSalary    Boolean  @default(false) // If percentage, is it on base salary?
  isTaxable       Boolean  @default(true) // Whether subject to income tax
  isProjectSpecific Boolean @default(false) // Can vary by project
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employeeAllowances EmployeeAllowance[]
}

model EmployeeAllowance {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  allowanceId     String
  allowance       Allowance @relation(fields: [allowanceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customValue     Float?   // Override the default value if set
  projectId       String?  // If project-specific
  isActive        Boolean  @default(true)
  effectiveDate   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// --- Attendance Engine ---
model Attendance {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  date            DateTime // The date of attendance
  status          String   @default("P") // P, W, H, CL, SL, EL, CO, T, WH, WW, CD, A
  projectId       String?  // Which project the employee worked on that day (deprecated — use AttendanceDailyProject)
  checkInTime     String?  // HH:mm format
  checkOutTime    String?  // HH:mm format
  overtimeHours   Float    @default(0)
  remarks         String?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  dailyProject    AttendanceDailyProject?

  @@unique([employeeId, date])
}

// --- Attendance Daily Project (attendance-based project allocation) ---
// Central join table linking each calendar day to a project for an employee.
// Created only when attendance status is billable (P, W, H, WH, WW, T, CO).
model AttendanceDailyProject {
  id         String   @id @default(cuid())
  employeeId String
  date       DateTime // The calendar date
  projectId  String
  status     String   // The attendance status that triggered this allocation

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attendance Attendance @relation(fields: [employeeId, date], references: [employeeId, date], onDelete: Cascade, onUpdate: Restrict)

  @@unique([employeeId, date])
  // One project per employee per day — no hour-splitting
}

// --- Project Cost Ledger ---
// Stores the output of each monthly payroll run. Written once per payroll run
// and treated as immutable after approval.
model ProjectCostLedger {
  id           String   @id @default(cuid())
  employeeId   String
  projectId    String
  month        DateTime // Always the 1st of the month

  totalDays    Int      // Days worked on this project in the month
  salaryShare  Float    // Salary attributed to this project
  scShare      Float    // Final payable SC attributed
  scBalance    Float    // Deferred SC (leave component)

  // SC component breakdown
  scOtherPayable Float  // 8.33% of scShare (relative to 20%)
  scEarnedLeave  Float  // 8.33% of scShare
  scSickLeave    Float  // 1.67% of scShare
  scCasualLeave  Float  // 1.67% of scShare

  createdAt    DateTime @default(now())

  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([employeeId, projectId, month])
}

// --- Loans & Advances ---
model Loan {
  id              String   @id @default(cuid())
  loanNumber      String   @unique // LOAN-YYYY-NNNN
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  loanType        String   // Personal, Emergency, Vehicle, Housing, Advance Salary, Other
  principalAmount Float
  interestRate    Float    @default(0) // Percentage, 0 for interest-free
  tenureMonths    Int      // Total number of installments
  disbursedAmount Float    @default(0)
  balanceAmount   Float    @default(0) // Remaining balance
  monthlyDeduction Float   @default(0) // Monthly deduction amount
  disbursementDate DateTime
  startDate       DateTime // When deductions start
  endDate         DateTime? // When deductions end
  status          String   @default("active") // active, closed, written_off
  isDisbursed     Boolean  @default(false)
  disbursedBy     String?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  installments    LoanInstallment[]
}

model LoanInstallment {
  id              String   @id @default(cuid())
  loanId          String
  loan            Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  installmentNo   Int      // 1, 2, 3...
  dueDate         DateTime
  amount          Float    // Principal + interest for this installment
  principalPart   Float    @default(0)
  interestPart    Float    @default(0)
  paidAmount      Float    @default(0)
  paidDate        DateTime?
  status          String   @default("pending") // pending, paid, partially_paid, waived
  payrollBatchLineId String? // Link to the payroll line that deducted this
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// --- Tax Slabs (Pakistan Income Tax) ---
model TaxSlab {
  id              String   @id @default(cuid())
  fiscalYear      String   // "2024-25"
  slabOrder       Int      // Order of the slab
  minAmount       Float    @default(0)
  maxAmount       Float?   // Null = no upper limit
  fixedAmount     Float    @default(0) // Fixed tax amount for this slab
  rate            Float    @default(0) // Percentage rate on amount exceeding min
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// --- Payroll Account Mapping (GL Integration) ---
model PayrollAccountMapping {
  id              String   @id @default(cuid())
  componentType   String   @unique // SALARY_EXPENSE, ALLOWANCE_EXPENSE, INCOME_TAX_PAYABLE, EOBI_EMPLOYEE, EOBI_EMPLOYER, PF_EMPLOYEE, PF_EMPLOYER, ESSI_EMPLOYEE, ESSI_EMPLOYER, SOCIAL_CHARGES, SALARY_PAYABLE, GRATUITY, LOAN_DEDUCTION, ADVANCE_DEDUCTION
  debitAccountId  String?  // GL account to debit
  creditAccountId String?  // GL account to credit
  description     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// --- Final Settlement ---
model FinalSettlement {
  id                    String   @id @default(cuid())
  employeeId            String   @unique
  employee              Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  leavingDate           DateTime
  settlementType        String   // Resignation, Termination, Retirement, Death
  basicSalary           Float    @default(0)
  unpaidSalary          Float    @default(0)
  leaveEncashment       Float    @default(0)
  gratuity              Float    @default(0)
  socialChargesPayout   Float    @default(0)
  loanBalance           Float    @default(0) // Outstanding loan to deduct
  advanceBalance        Float    @default(0) // Outstanding advance to deduct
  otherDeductions       Float    @default(0)
  totalPayable          Float    @default(0)
  totalDeductions       Float    @default(0)
  netSettlement         Float    @default(0)
  status                String   @default("draft") // draft, approved, paid, posted
  postedVoucherId       String?
  approvedBy            String?
  paidBy                String?
  createdBy             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// --- Enhanced Payroll Batch ---
model PayrollBatch {
  id              String   @id @default(cuid())
  batchNumber     String   @unique
  name            String   @default("Payroll Batch")
  period          String   // "2024-01"
  projectId       String?  // Project for cross-charging

  // Financial totals
  totalBasicSalary      Float    @default(0)
  totalAllowances       Float    @default(0)
  totalGross            Float    @default(0)
  totalIncomeTax        Float    @default(0)
  totalEobiEmployee     Float    @default(0)
  totalEobiEmployer     Float    @default(0)
  totalPfEmployee       Float    @default(0)
  totalPfEmployer       Float    @default(0)
  totalLoanDeduction    Float    @default(0)
  totalAdvanceDeduction Float    @default(0)
  totalOtherDeductions  Float    @default(0)
  totalDeductions       Float    @default(0)
  totalNetPay           Float    @default(0)
  totalEmployerCharges  Float    @default(0)
  totalSocialCharges    Float    @default(0)
  totalGratuity         Float    @default(0)
  totalEssiEmployee     Float    @default(0)
  totalEssiEmployer     Float    @default(0)

  // Workflow
  status          String   @default("draft") // draft, reviewed, approved, posted
  postedToGL      Boolean  @default(false)
  postedVoucherId String?  // Reference to GL voucher
  reviewedBy      String?
  approvedBy      String?
  postedBy        String?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lines           PayrollBatchLine[]
}

model PayrollBatchLine {
  id              String      @id @default(cuid())
  batchId         String
  batch           PayrollBatch @relation(fields: [batchId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  employeeId      String
  employeeName    String
  employeeCode    String?

  // Salary breakdown
  basicSalary     Float       @default(0)
  dailyRate       Float       @default(0) // basicSalary / daysInMonth
  workingDays     Int         @default(0)
  eligibleDays    Int         @default(0)
  leaveDays       Int         @default(0)
  absentDays      Int         @default(0)

  // Allowances (stored as JSON for flexibility)
  allowanceDetails String?    // JSON: [{allowanceId, name, amount, isTaxable}]

  // Gross
  allowances      Float       @default(0)
  grossSalary     Float       @default(0)

  // Deductions
  incomeTax       Float       @default(0)
  eobiEmployee    Float       @default(0)
  eobiEmployer    Float       @default(0)
  pfEmployee      Float       @default(0)
  pfEmployer      Float       @default(0)
  loanDeduction   Float       @default(0)
  advanceDeduction Float      @default(0)
  otherDeductions Float       @default(0)
  totalDeductions Float       @default(0)

  // Net
  netPay          Float       @default(0)

  // Calendar & Attendance
  calendarDays    Int         @default(0) // Total calendar days in month (28-31)
  payableDays     Int         @default(0) // Calendar Days - Absents

  // Social Charges (Employer)
  socialCharges   Float       @default(0)
  gratuity        Float       @default(0)
  essiEmployee    Float       @default(0) // ESSI employee contribution
  essiEmployer    Float       @default(0) // ESSI employer contribution

  // SC Calculation breakdown
  scBreakdown     String?     // JSON: {monthlySC, workingRatio, earnedSC, leaveDeduction, finalSC}
  lineStatus      String      @default("draft") // draft, approved — individual line approval for Draft to GL

  // Project & Cost Center
  projectId       String?
  department      String?

  // Tax calculation breakdown (YTD + Rolling Projection)
  taxBreakdown    String?     // JSON: {taxableIncome, ytdIncome, projectedAnnualIncome, monthsWorkedYtd, taxSlab, fixedTax, variableTax, taxPaidYtd}

  // Project allocation details
  projectAllocations String?  // JSON: [{projectId, projectName, projectCode, days, weight, weightPct, salaryShare, scShare}]
  contractEarnings   String?  // JSON: [{assignmentId, projectId, projectName, projectCode, contractSalary, dailyRate, daysWorked, earnedSalary, absentDays, designation, scShare, ...}]

  // Relations
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

// ============================================================
// IMPORT/EXPORT LOG
// ============================================================

model ImportLog {
  id          String   @id @default(cuid())
  fileName    String
  fileType    String   // CSV, XLSX
  importType  String   // DONOR_INVOICE, CHART_OF_ACCOUNTS, etc.
  recordCount Int
  successCount Int
  failCount   Int
  errors      String?  // JSON string of error details
  importedBy  String
  createdAt   DateTime @default(now())
}

model ExportLog {
  id          String   @id @default(cuid())
  exportType  String   // TRIAL_BALANCE, PNL, BALANCE_SHEET, etc.
  format      String   // PDF, XLSX, DOCX
  parameters  String?  // JSON string of export parameters
  exportedBy  String
  createdAt   DateTime @default(now())
}

// ============================================================
// SYSTEM SETTINGS
// ============================================================

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique  // e.g., company_name, base_currency, fiscal_year_start_month
  value     String   // JSON string for complex values, plain string for simple ones
  category  String   @default("general") // general, voucher, security, integration, appearance
  description String? // Human-readable description of the setting
  isPublic  Boolean  @default(false) // Whether this setting is safe to expose to client
  updatedAt DateTime @updatedAt
}
