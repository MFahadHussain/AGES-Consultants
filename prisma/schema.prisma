// Accounting & Financial Management System - Complete Database Schema
// Supports: Chart of Accounts, Vouchers, Ledgers, Bank Reconciliation,
// Project/Segment Accounting, Budgets, Taxation, Aging, Financial Years,
// Integration with Payroll & Fixed Assets

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// CORE: Users & Roles
// ============================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String   @default("") // bcrypt hash; empty for system/OAuth users
  role         String   @default("viewer") // admin, manager, accountant, auditor, viewer
  isActive     Boolean  @default(true)
  avatarUrl    String?  // Optional avatar URL
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs       AuditLog[]
  voucherActions  VoucherApproval[]
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String   // CREATE, UPDATE, DELETE, APPROVE, REJECT
  entity    String   // Account, Voucher, Budget, etc.
  entityId  String
  details   String?  // JSON string with change details
  createdAt DateTime @default(now())
}

// ============================================================
// CHART OF ACCOUNTS
// ============================================================

model Account {
  id            String    @id @default(cuid())
  code          String    @unique
  name          String
  accountType   String    // ASSET, LIABILITY, EQUITY, INCOME, EXPENSE
  subType       String?   // CURRENT_ASSET, FIXED_ASSET, CURRENT_LIABILITY, etc.
  parentId      String?   // For hierarchical accounts
  parent        Account?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children      Account[] @relation("AccountHierarchy")
  level         Int       @default(0)
  isActive      Boolean   @default(true)
  isSystem      Boolean   @default(false) // System accounts cannot be deleted
  allowPosting  Boolean   @default(true) // Whether direct postings allowed
  openingBalance Float    @default(0)
  description   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  voucherEntries    VoucherEntry[]
  budgetEntries   BudgetLine[]
  taxAccounts     TaxRate[]
  bankStatements  BankStatement[]
  bankReconciliations BankReconciliation[]

}

// ============================================================
// FINANCIAL YEAR
// ============================================================

model FinancialYear {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "FY 2024-25"
  startDate   DateTime
  endDate     DateTime
  status      String   @default("open") // open, closing, closed
  closedBy    String?
  closedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vouchers    Voucher[]
  budgets     Budget[]
}

// ============================================================
// PROJECTS & SEGMENTS
// ============================================================

model Project {
  id                   String    @id @default(cuid())
  code                 String    @unique // e.g. "AJK-HPP", "HO"
  name                 String
  projectType          String    @default("Other") // Head Office, Hydropower, Dam, Infrastructure, Other
  description          String?
  startDate            DateTime?
  endDate              DateTime?
  status               String    @default("active") // active, completed, on-hold
  isHeadOffice         Boolean   @default(false)
  reportingCurrency    String    @default("PKR")
  sortOrder            Int       @default(0) // column ordering in multi-column reports
  parentProjectId      String?   // self-referencing for sub-projects
  parentProject        Project?  @relation("ProjectHierarchy", fields: [parentProjectId], references: [id])
  subProjects          Project[] @relation("ProjectHierarchy")
  intraCompanyAccountId String?  // FK to Account for intra-company eliminations
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  vouchers    Voucher[]
  budgets     Budget[]
  employeeAssignments EmployeeProjectAssignment[]
  defaultEmployees    Employee[] // Employees with this as default project
  dailyProjectRecords AttendanceDailyProject[]
  costLedgerEntries  ProjectCostLedger[]
}

model FinancialReportConfig {
  id              String   @id @default(cuid())
  reportName      String
  reportType      String   // Balance Sheet, P&L, Cash Flow, Fixed Asset Schedule, Intangible Asset Schedule, Multi-Column Balance Sheet
  viewMode        String   @default("single") // single, multi_column, consolidated
  fromDate        DateTime
  toDate          DateTime
  projectIds      String   @default("[]") // JSON array of project IDs
  detailLevel     String   @default("summary") // summary, detailed
  isFinalized     Boolean  @default(false)
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Donor {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  contactPerson String?
  email       String?
  phone       String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vouchers    Voucher[]
  budgets     Budget[]
}

model Location {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vouchers    Voucher[]
}

model Client {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  industry      String?  // e.g., Government, NGO, Corporate, Individual
  taxNumber     String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vouchers    Voucher[]
}

// ============================================================
// CUSTOMERS & SUPPLIERS (Sub-Ledger Masters)
// ============================================================

model Customer {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  creditTerms   Int      @default(30) // days
  creditLimit   Float    @default(0)
  taxNumber     String?
  isActive      Boolean  @default(true)
  openingBalance Float   @default(0) // Receivable opening balance
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  voucherEntries VoucherEntry[]
}

model Supplier {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  creditTerms   Int      @default(30) // days
  taxNumber     String?
  bankName      String?
  bankAccount   String?
  isActive      Boolean  @default(true)
  openingBalance Float   @default(0) // Payable opening balance
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  voucherEntries VoucherEntry[]
}

// ============================================================
// VOUCHER MANAGEMENT
// ============================================================

model Voucher {
  id              String    @id @default(cuid())
  voucherNumber   String    @unique
  voucherType     String    // BP, CP, BR, CR, JV, BILL
  voucherTypeName String    // Bank Payment, Cash Payment, Bank Receipt, Cash Receipt, Journal Voucher, Bill
  date            DateTime
  narration       String
  reference       String?
  payeeName       String?   // Name of the payee/beneficiary
  chequeNumber    String?
  chequeDate      DateTime?
  voucherNo       String?   // Manual/custom voucher number (separate from auto-generated voucherNumber)
  amountInWords   String?   // Total amount expressed in words
  status          String    @default("draft") // draft, pending, approved, posted, rejected
  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id])
  projectId       String?
  project         Project?  @relation(fields: [projectId], references: [id])
  donorId         String?
  donor           Donor?    @relation(fields: [donorId], references: [id])
  locationId      String?
  location        Location? @relation(fields: [locationId], references: [id])
  clientId        String?
  client          Client?   @relation(fields: [clientId], references: [id])
  totalDebit      Float     @default(0)
  totalCredit     Float     @default(0)
  isPayrollPosted Boolean   @default(false) // INTEGRATION: Payroll → GL
  isAssetPosted   Boolean   @default(false) // INTEGRATION: Fixed Assets → GL
  isReconciled    Boolean   @default(false) // BANK RECONCILIATION: Whether this voucher has been cleared in bank reconciliation
  clearanceDate   DateTime? // BANK RECONCILIATION: Date when the voucher was cleared on bank statement
  createdBy       String
  reviewedBy      String?   // Manager who moved to Pending
  approvedBy      String?   // Manager/Admin who approved
  postedBy        String?   // Admin who posted to GL
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  entries       VoucherEntry[]
  approvals     VoucherApproval[]
  attachments   VoucherAttachment[]
  bankRecon     BankReconciliationItem[]
}

model VoucherEntry {
  id          String  @id @default(cuid())
  voucherId   String
  voucher     Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  lineNumber  Int
  accountId   String
  account     Account @relation(fields: [accountId], references: [id])
  debit       Float   @default(0)
  credit      Float   @default(0)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  description String?
  projectId   String? // Override at line level
  donorId     String? // Override at line level
  locationId  String? // Override at line level

  // INTEGRATION: Payroll reference
  payrollRef  String? // Reference to payroll batch
  // INTEGRATION: Fixed Asset reference
  assetRef    String? // Reference to fixed asset
}

model VoucherApproval {
  id          String   @id @default(cuid())
  voucherId   String
  voucher     Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  action      String   // SUBMIT, REVIEW, APPROVE, REJECT, POST, QUICK_POST, REVOKE
  fromStatus  String?  // Previous status before action
  toStatus    String?  // New status after action
  comments    String?
  userRole    String?  // Role of the user at time of action
  createdAt   DateTime @default(now())
}

model VoucherAttachment {
  id          String   @id @default(cuid())
  voucherId   String
  voucher     Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  fileName    String
  filePath    String   // Secure storage path (not publicly accessible)
  fileSize    Int?
  fileType    String?  // MIME type
  mimeType    String?  // application/pdf, image/jpeg, etc.
  category    String?  // invoice, receipt, contract, other
  description String?
  uploadedBy  String
  uploadedByName String? // Denormalized for display
  isVerified  Boolean  @default(false) // Verified by manager/admin
  createdAt   DateTime @default(now())
}

// ============================================================
// BANK RECONCILIATION
// ============================================================

model BankStatement {
  id            String   @id @default(cuid())
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id])
  statementDate DateTime
  openingBalance Float
  closingBalance Float
  importedAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  items         BankStatementItem[]
}

model BankStatementItem {
  id            String   @id @default(cuid())
  bankStatementId String
  bankStatement  BankStatement @relation(fields: [bankStatementId], references: [id], onDelete: Cascade)
  date          DateTime
  description   String
  amount        Float
  type          String   // DEPOSIT, WITHDRAWAL
  reference     String?
  isMatched     Boolean  @default(false)

  reconItems    BankReconciliationItem[]
}

model BankReconciliationItem {
  id                  String   @id @default(cuid())
  bankStatementItemId String? @unique
  bankStatementItem   BankStatementItem? @relation(fields: [bankStatementItemId], references: [id])
  voucherId           String
  voucher             Voucher  @relation(fields: [voucherId], references: [id])
  reconciliationDate  DateTime @default(now())
  status              String   @default("matched") // matched, unmatched, outstanding
  reconciledBy        String
  createdAt           DateTime @default(now())
}

model BankReconciliation {
  id                String   @id @default(cuid())
  accountId         String
  account           Account  @relation(fields: [accountId], references: [id])
  period            String   // "2025-01" format (YYYY-MM)
  statementBalance  Float    // User-entered bank statement balance (CR)
  bookBalance       Float    // Computed book balance (DR)
  unpresentedTotal  Float    @default(0) // Sum of unchecked payments
  uncreditedTotal   Float    @default(0) // Sum of unchecked receipts
  adjustedBookBalance  Float @default(0)
  adjustedBankBalance  Float @default(0)
  status            String   @default("draft") // draft, finalized
  finalizedBy       String?
  finalizedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([accountId, period])
}

// ============================================================
// BUDGET MANAGEMENT
// ============================================================

model Budget {
  id              String   @id @default(cuid())
  name            String
  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id])
  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id])
  donorId         String?
  donor           Donor?   @relation(fields: [donorId], references: [id])
  period          String?  // MONTHLY, QUARTERLY, ANNUAL
  status          String   @default("draft") // draft, approved, active
  totalAmount     Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lines           BudgetLine[]
}

model BudgetLine {
  id          String   @id @default(cuid())
  budgetId    String
  budget      Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])
  period      String   // "2024-01", "2024-Q1", "2024"
  budgetAmount Float
  actualAmount Float    @default(0)
  commitmentAmount Float @default(0)
}

// ============================================================
// TAXATION
// ============================================================

model TaxRate {
  id          String   @id @default(cuid())
  name        String
  taxType     String   // INCOME_TAX, SALES_TAX, GST, ZAKAT
  rate        Float
  accountId   String?  // Default tax account
  account     Account? @relation(fields: [accountId], references: [id])
  effectiveFrom DateTime
  effectiveTo   DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  calculations TaxCalculation[]
}

model TaxCalculation {
  id            String   @id @default(cuid())
  taxRateId     String
  taxRate       TaxRate  @relation(fields: [taxRateId], references: [id])
  voucherId     String?
  baseAmount    Float
  taxAmount     Float
  period        String   // "2024-01"
  calculatedAt  DateTime @default(now())
  postedToGL    Boolean  @default(false)
}

// ============================================================
// FINANCIAL YEAR BALANCES (for carry-forward)
// ============================================================

model AccountBalance {
  id              String   @id @default(cuid())
  accountId       String
  // Note: AccountBalance references Account but no formal FK to avoid circular issues
  financialYearId String
  openingDebit    Float    @default(0)
  openingCredit   Float    @default(0)
  periodDebit     Float    @default(0)
  periodCredit    Float    @default(0)
  closingDebit    Float    @default(0)
  closingCredit   Float    @default(0)
  period          String   // "2024-01", "2024-Q1", "2024"

  @@unique([accountId, financialYearId, period])
}

// ============================================================
// FIXED ASSETS MANAGEMENT SYSTEM (FAMS)
// ============================================================

model FixedAsset {
  id                    String   @id @default(cuid())
  assetId               String   @unique  // AST-YYYY-NNNN
  name                  String
  description           String?
  category              String   // Land, Buildings, Vehicles, Furniture, Office Equipment, IT Assets, Machinery, Other
  subCategory           String?
  dateOfPurchase        DateTime
  dateOfCapitalization  DateTime
  purchasePrice         Float    // PKR
  residualValue         Float    @default(0) // PKR
  usefulLifeYears       Int      @default(0)
  depreciationMethod    String   @default("Straight-Line") // Straight-Line, Declining-Balance, None
  decliningRate         Float    @default(0) // % for declining balance
  custodian             String?
  location              String?
  province              String   @default("KPK") // Punjab, Sindh, KPK, Balochistan, ICT, AJK, GB
  donor                 String?
  isDonorFunded         Boolean  @default(false)
  donorRestrictions     String?
  grantReference        String?
  invoiceNumber         String?
  supplierName          String?
  supplierNTN           String?
  warrantyExpiryDate    DateTime?
  serialNumber          String?
  make                  String?   // e.g., Toyota, Dell, HP
  model                 String?   // e.g., Corolla, Latitude 5520
  modelYear             Int?      // e.g., 2023
  priorApprovalNo       String?   // Prior approval reference number
  purchaseOrderNo       String?   // Purchase order number
  receiptVoucherNo      String?   // Receipt voucher reference
  checkRegisterNo       String?   // Check register reference
  stockRegisterPageNo   String?   // Stock register page number
  assetTag              String?   // Manual asset tag identifier (e.g., FA-IT-2024-001)
  status                String   @default("Active") // Active, Disposed, Transferred, Under Maintenance, Written Off
  condition             String   @default("Good") // Excellent, Good, Fair, Poor
  insuranceValue        Float    @default(0)
  insurancePolicyNumber String?
  insuranceExpiryDate   DateTime?
  costCenter            String?
  project               String?
  fundCode              String?
  donorCode             String?
  glAssetAccount        String?
  glAccDepAccount       String?
  glDepExpAccount       String?
  taxCategory           String?
  taxRate               Float    @default(0)
  taxMethod             String   @default("Declining-Balance")
  approvalStatus        String   @default("Draft") // Draft, Pending Approval, Approved, Rejected
  approvedBy            String?
  createdBy             String?
  journalStatus         String   @default("Pending Export") // Pending Export, Exported
  notes                 String?
  accumulatedDepreciation Float  @default(0)
  netBookValue          Float    @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  depreciationRecords   FixedAssetDepreciation[]
  transactions          AssetTransaction[]
}

model FixedAssetDepreciation {
  id                      String   @id @default(cuid())
  assetId                 String
  asset                   FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  financialYear           String   // "2024-25"
  period                  String   // "Jul-2024"
  monthNumber             Int      // 1-12 (1=July)
  openingNBV              Float
  depreciationCharge      Float
  accumulatedDepreciation Float
  closingNBV              Float
  isPosted                Boolean  @default(false)
  journalRef              String?
  journalStatus           String   @default("Pending Export") // Pending Export, Exported
  isTaxDepreciation       Boolean  @default(false) // true for FBR tax depreciation
  taxOpeningWDV           Float    @default(0)
  taxCharge               Float    @default(0)
  taxClosingWDV           Float    @default(0)
  createdAt               DateTime @default(now())
}

model AssetTransaction {
  id              String   @id @default(cuid())
  txnId           String   @unique  // TXN-YYYY-NNNN
  assetId         String
  asset           FixedAsset @relation(fields: [assetId], references: [id])
  type            String   // Addition, Disposal, Transfer, Adjustment, Reversal
  date            DateTime
  description     String?
  amount          Float    @default(0)
  fromLocation    String?
  toLocation      String?
  fromCustodian   String?
  toCustodian     String?
  fromCostCenter  String?
  toCostCenter    String?
  proceeds        Float    @default(0) // For disposal
  gainLoss        Float    @default(0) // Positive = gain, negative = loss
  disposalMethod  String?  // Sale, Scrap, Donation, Write-Off, Transfer to Govt
  adjustmentType  String?  // Upward Revaluation, Downward (Impairment), Correction
  newValue        Float?   // For adjustments/revaluations
  transferCertNo  String?  // TC-YYYY-NNNN
  approvedBy      String?
  status          String   @default("Draft") // Draft, Approved, Posted, Reversed, Pending Acknowledgment
  journalRef      String?
  journalStatus   String   @default("Pending Export") // Pending Export, Exported, N/A
  notes           String?
  createdBy       String?
  createdAt       DateTime @default(now())
}

model FAMSFiscalYear {
  id            String   @id @default(cuid())
  label         String   @unique // "2024-25"
  startDate     DateTime
  endDate       DateTime
  status        String   @default("Open") // Open, Closed
  depRunStatus  String   @default("{}") // JSON: {"Jul-2024": "Complete", "Aug-2024": "Pending", ...}
  openedBy      String?
  openedAt      DateTime @default(now())
  closedBy      String?
  closedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model FAMSJournal {
  id              String   @id @default(cuid())
  journalNumber   String   @unique  // JV-FAMS-YYYY-NNNN
  type            String   // Addition, Depreciation, Disposal, Adjustment
  date            DateTime
  narration       String?
  assetId         String?
  assetName       String?
  drAccountCode   String?
  drAccountName   String?
  drAmount        Float    @default(0)
  crAccountCode   String?
  crAccountName   String?
  crAmount        Float    @default(0)
  costCenter      String?
  project         String?
  fundCode        String?
  source          String   @default("FAMS")
  status          String   @default("Pending Export") // Pending Export, Exported, Reversed
  exportBatchId   String?
  createdAt       DateTime @default(now())
  exportedAt      DateTime?
}

model FAMSExportBatch {
  id              String   @id @default(cuid())
  batchRef        String   @unique  // EXP-YYYY-NNNN
  exportDate      DateTime @default(now())
  exportedBy      String?
  entryCount      Int      @default(0)
  totalDrAmount   Float    @default(0)
  totalCrAmount   Float    @default(0)
  csvContent      String?  // Store the CSV content for re-download
  createdAt       DateTime @default(now())
}

model FAMSSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String   @default("fams") // fams, gl-mapping, thresholds, tax-rates
  description String?
  updatedAt DateTime @updatedAt
}

// ============================================================
// PAYROLL & HR MANAGEMENT SYSTEM
// ============================================================

// --- Employee Master (Highly Normalized) ---
model Employee {
  id                String   @id @default(cuid())
  employeeCode      String   @unique // Auto-generated: EMP-0001

  // Personal Info
  name              String
  fatherName        String?
  cnic              String   @unique // Must be unique
  ntn               String?
  dateOfBirth       DateTime?
  religion          String?
  gender            String?  // Male, Female, Other
  contactNo         String?
  email             String?
  permanentAddress  String?
  presentAddress    String?
  profilePhotoUrl   String?  // File path for profile photo

  // Employment Info
  designation       String?
  department        String?
  joiningDate       DateTime?
  leavingDate       DateTime? // Null if active
  employmentType    String?   // Permanent, Contract, Temporary, Intern, Consultant
  category          String?   // Management, Staff, Worker, Officer
  defaultProjectId  String?   // Default project assignment
  defaultProject    Project? @relation(fields: [defaultProjectId], references: [id])
  status            String   @default("active") // active, inactive, terminated, resigned, retired

  // Banking
  bankName          String?
  branchName        String?
  branchCode        String?
  bankAccountNumber String?

  // Statutory
  eobiNumber        String?
  socialSecurityNo  String?
  eobiEnabled       Boolean  @default(false) // Whether EOBI deduction applies
  pfEnabled         Boolean  @default(false) // Whether Provident Fund deduction applies

  // Qualification
  qualification1    String?
  institute1        String?
  year1             String?
  qualification2    String?
  institute2        String?
  year2             String?

  // Experience
  previousEmployer  String?
  yearsOfExperience String?

  // Next of Kin
  nokName           String?
  nokCnic           String?
  nokContact        String?
  nokRelation       String?

  // Salary
  baseSalary        Float    @default(0) // Current base salary
  paymentType       String   @default("monthly") // monthly, daily, hourly

  // System
  isFinancialUsed   Boolean  @default(false) // Cannot delete after financial usage
  createdBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  salaryHistory     EmployeeSalaryHistory[]
  projectAssignments EmployeeProjectAssignment[]
  allowances        EmployeeAllowance[]
  attendanceRecords Attendance[]
  dailyProjectRecords AttendanceDailyProject[]
  costLedgerEntries ProjectCostLedger[]
  loanRecords       Loan[]
  payrollLines      PayrollBatchLine[]
  finalSettlement   FinalSettlement?
}

model EmployeeSalaryHistory {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  effectiveDate   DateTime // When the salary change took effect
  previousSalary  Float    @default(0)
  newSalary       Float
  changeReason    String?  // Annual increment, Promotion, Adjustment, Lateral move
  approvedBy      String?
  createdBy       String?
  createdAt       DateTime @default(now())
}

// --- Employee-Project Assignment Engine ---
model EmployeeProjectAssignment {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id])
  role            String?  // Role/Designation on this project
  salaryAmount    Float    @default(0) // Project-specific salary
  allocationType  String   @default("fixed") // fixed, percentage, attendance_based
  allocationValue Float    @default(100) // Percentage or fixed amount
  startDate       DateTime
  endDate         DateTime? // Null = ongoing
  isActive        Boolean  @default(true)
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// --- Allowances & Benefits Engine ---
model Allowance {
  id              String   @id @default(cuid())
  code            String   @unique // MED, HRA, TA, PA
  name            String   // Medical Allowance, Housing, Transport, Project Allowance
  allowanceType   String   @default("fixed") // fixed, percentage
  value           Float    @default(0) // Fixed amount or percentage
  baseOnSalary    Boolean  @default(false) // If percentage, is it on base salary?
  isTaxable       Boolean  @default(true) // Whether subject to income tax
  isProjectSpecific Boolean @default(false) // Can vary by project
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employeeAllowances EmployeeAllowance[]
}

model EmployeeAllowance {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  allowanceId     String
  allowance       Allowance @relation(fields: [allowanceId], references: [id])
  customValue     Float?   // Override the default value if set
  projectId       String?  // If project-specific
  isActive        Boolean  @default(true)
  effectiveDate   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// --- Attendance Engine ---
model Attendance {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date            DateTime // The date of attendance
  status          String   @default("P") // P, W, H, CL, SL, EL, CO, T, WH, WW, CD, A
  projectId       String?  // Which project the employee worked on that day (deprecated — use AttendanceDailyProject)
  checkInTime     String?  // HH:mm format
  checkOutTime    String?  // HH:mm format
  overtimeHours   Float    @default(0)
  remarks         String?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  dailyProject    AttendanceDailyProject?

  @@unique([employeeId, date])
}

// --- Attendance Daily Project (attendance-based project allocation) ---
// Central join table linking each calendar day to a project for an employee.
// Created only when attendance status is billable (P, W, H, WH, WW, T, CO).
model AttendanceDailyProject {
  id         String   @id @default(cuid())
  employeeId String
  date       DateTime // The calendar date
  projectId  String
  status     String   // The attendance status that triggered this allocation

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project    Project  @relation(fields: [projectId], references: [id])
  attendance Attendance @relation(fields: [employeeId, date], references: [employeeId, date], onDelete: Cascade)

  @@unique([employeeId, date])
  // One project per employee per day — no hour-splitting
}

// --- Project Cost Ledger ---
// Stores the output of each monthly payroll run. Written once per payroll run
// and treated as immutable after approval.
model ProjectCostLedger {
  id           String   @id @default(cuid())
  employeeId   String
  projectId    String
  month        DateTime // Always the 1st of the month

  totalDays    Int      // Days worked on this project in the month
  salaryShare  Float    // Salary attributed to this project
  scShare      Float    // Final payable SC attributed
  scBalance    Float    // Deferred SC (leave component)

  // SC component breakdown
  scOtherPayable Float  // 8.33% of scShare (relative to 20%)
  scEarnedLeave  Float  // 8.33% of scShare
  scSickLeave    Float  // 1.67% of scShare
  scCasualLeave  Float  // 1.67% of scShare

  createdAt    DateTime @default(now())

  employee     Employee @relation(fields: [employeeId], references: [id])
  project      Project  @relation(fields: [projectId], references: [id])

  @@unique([employeeId, projectId, month])
}

// --- Loans & Advances ---
model Loan {
  id              String   @id @default(cuid())
  loanNumber      String   @unique // LOAN-YYYY-NNNN
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  loanType        String   // Personal, Emergency, Vehicle, Housing, Advance Salary, Other
  principalAmount Float
  interestRate    Float    @default(0) // Percentage, 0 for interest-free
  tenureMonths    Int      // Total number of installments
  disbursedAmount Float    @default(0)
  balanceAmount   Float    @default(0) // Remaining balance
  monthlyDeduction Float   @default(0) // Monthly deduction amount
  disbursementDate DateTime
  startDate       DateTime // When deductions start
  endDate         DateTime? // When deductions end
  status          String   @default("active") // active, closed, written_off
  isDisbursed     Boolean  @default(false)
  disbursedBy     String?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  installments    LoanInstallment[]
}

model LoanInstallment {
  id              String   @id @default(cuid())
  loanId          String
  loan            Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  installmentNo   Int      // 1, 2, 3...
  dueDate         DateTime
  amount          Float    // Principal + interest for this installment
  principalPart   Float    @default(0)
  interestPart    Float    @default(0)
  paidAmount      Float    @default(0)
  paidDate        DateTime?
  status          String   @default("pending") // pending, paid, partially_paid, waived
  payrollBatchLineId String? // Link to the payroll line that deducted this
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// --- Tax Slabs (Pakistan Income Tax) ---
model TaxSlab {
  id              String   @id @default(cuid())
  fiscalYear      String   // "2024-25"
  slabOrder       Int      // Order of the slab
  minAmount       Float    @default(0)
  maxAmount       Float?   // Null = no upper limit
  fixedAmount     Float    @default(0) // Fixed tax amount for this slab
  rate            Float    @default(0) // Percentage rate on amount exceeding min
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// --- Payroll Account Mapping (GL Integration) ---
model PayrollAccountMapping {
  id              String   @id @default(cuid())
  componentType   String   @unique // SALARY_EXPENSE, ALLOWANCE_EXPENSE, INCOME_TAX_PAYABLE, EOBI_EMPLOYEE, EOBI_EMPLOYER, PF_EMPLOYEE, PF_EMPLOYER, SOCIAL_CHARGES, SALARY_PAYABLE, GRATUITY, LOAN_DEDUCTION, ADVANCE_DEDUCTION
  debitAccountId  String?  // GL account to debit
  creditAccountId String?  // GL account to credit
  description     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// --- Final Settlement ---
model FinalSettlement {
  id                    String   @id @default(cuid())
  employeeId            String   @unique
  employee              Employee @relation(fields: [employeeId], references: [id])
  leavingDate           DateTime
  settlementType        String   // Resignation, Termination, Retirement, Death
  basicSalary           Float    @default(0)
  unpaidSalary          Float    @default(0)
  leaveEncashment       Float    @default(0)
  gratuity              Float    @default(0)
  socialChargesPayout   Float    @default(0)
  loanBalance           Float    @default(0) // Outstanding loan to deduct
  advanceBalance        Float    @default(0) // Outstanding advance to deduct
  otherDeductions       Float    @default(0)
  totalPayable          Float    @default(0)
  totalDeductions       Float    @default(0)
  netSettlement         Float    @default(0)
  status                String   @default("draft") // draft, approved, paid, posted
  postedVoucherId       String?
  approvedBy            String?
  paidBy                String?
  createdBy             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// --- Enhanced Payroll Batch ---
model PayrollBatch {
  id              String   @id @default(cuid())
  batchNumber     String   @unique
  name            String   @default("Payroll Batch")
  period          String   // "2024-01"
  projectId       String?  // Project for cross-charging

  // Financial totals
  totalBasicSalary      Float    @default(0)
  totalAllowances       Float    @default(0)
  totalGross            Float    @default(0)
  totalIncomeTax        Float    @default(0)
  totalEobiEmployee     Float    @default(0)
  totalEobiEmployer     Float    @default(0)
  totalPfEmployee       Float    @default(0)
  totalPfEmployer       Float    @default(0)
  totalLoanDeduction    Float    @default(0)
  totalAdvanceDeduction Float    @default(0)
  totalOtherDeductions  Float    @default(0)
  totalDeductions       Float    @default(0)
  totalNetPay           Float    @default(0)
  totalEmployerCharges  Float    @default(0)
  totalSocialCharges    Float    @default(0)
  totalGratuity         Float    @default(0)

  // Workflow
  status          String   @default("draft") // draft, reviewed, approved, posted
  postedToGL      Boolean  @default(false)
  postedVoucherId String?  // Reference to GL voucher
  reviewedBy      String?
  approvedBy      String?
  postedBy        String?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lines           PayrollBatchLine[]
}

model PayrollBatchLine {
  id              String      @id @default(cuid())
  batchId         String
  batch           PayrollBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  employeeId      String
  employeeName    String
  employeeCode    String?

  // Salary breakdown
  basicSalary     Float       @default(0)
  dailyRate       Float       @default(0) // basicSalary / daysInMonth
  workingDays     Int         @default(0)
  eligibleDays    Int         @default(0)
  leaveDays       Int         @default(0)
  absentDays      Int         @default(0)

  // Allowances (stored as JSON for flexibility)
  allowanceDetails String?    // JSON: [{allowanceId, name, amount, isTaxable}]

  // Gross
  allowances      Float       @default(0)
  grossSalary     Float       @default(0)

  // Deductions
  incomeTax       Float       @default(0)
  eobiEmployee    Float       @default(0)
  eobiEmployer    Float       @default(0)
  pfEmployee      Float       @default(0)
  pfEmployer      Float       @default(0)
  loanDeduction   Float       @default(0)
  advanceDeduction Float      @default(0)
  otherDeductions Float       @default(0)
  totalDeductions Float       @default(0)

  // Net
  netPay          Float       @default(0)

  // Social Charges (Employer)
  socialCharges   Float       @default(0)
  gratuity        Float       @default(0)

  // SC Calculation breakdown
  scBreakdown     String?     // JSON: {monthlySC, workingRatio, earnedSC, leaveDeduction, finalSC}

  // Project & Cost Center
  projectId       String?
  department      String?

  // Tax calculation breakdown
  taxBreakdown    String?     // JSON: {taxableIncome, taxSlab, fixedTax, variableTax}

  // Relations
  employee        Employee  @relation(fields: [employeeId], references: [id])
}

// ============================================================
// IMPORT/EXPORT LOG
// ============================================================

model ImportLog {
  id          String   @id @default(cuid())
  fileName    String
  fileType    String   // CSV, XLSX
  importType  String   // DONOR_INVOICE, CHART_OF_ACCOUNTS, etc.
  recordCount Int
  successCount Int
  failCount   Int
  errors      String?  // JSON string of error details
  importedBy  String
  createdAt   DateTime @default(now())
}

model ExportLog {
  id          String   @id @default(cuid())
  exportType  String   // TRIAL_BALANCE, PNL, BALANCE_SHEET, etc.
  format      String   // PDF, XLSX, DOCX
  parameters  String?  // JSON string of export parameters
  exportedBy  String
  createdAt   DateTime @default(now())
}

// ============================================================
// SYSTEM SETTINGS
// ============================================================

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique  // e.g., company_name, base_currency, fiscal_year_start_month
  value     String   // JSON string for complex values, plain string for simple ones
  category  String   @default("general") // general, voucher, security, integration, appearance
  description String? // Human-readable description of the setting
  isPublic  Boolean  @default(false) // Whether this setting is safe to expose to client
  updatedAt DateTime @updatedAt
}
